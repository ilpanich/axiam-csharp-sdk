<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- WebApplicationFactory/TestServer host for the SC#3 integration test (Task 3) —
         Microsoft.AspNetCore.Mvc.Testing transitively brings in Microsoft.AspNetCore.TestHost.

         This is the one package reference that MUST be conditioned per target
         framework. Mvc.Testing ships a build per ASP.NET Core major and carries the
         matching shared-framework version with it: 8.0.30 targets net8.0 only, so
         restoring it for the net10.0 leg resolves nothing usable. Every other
         dependency in this repo is TFM-agnostic (netstandard2.0 or multi-targeted)
         and needs no condition. The 10.0.11 pin matches the Microsoft.Extensions.*
         10.0.11 already pinned in Axiam.Sdk.csproj. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.30"
                      Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Hosting/TestHost/Routing/Authorization APIs used to build the in-memory ASP.NET
       Core 8+ test host — mirrors the exact FrameworkReference pattern
       Axiam.Sdk.AspNetCore.csproj (D-03) and the core Axiam.Sdk.Tests.csproj (21-05,
       for its Grpc.AspNetCore.Server-hosted Kestrel test server) already use. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Axiam.Sdk.AspNetCore/Axiam.Sdk.AspNetCore.csproj" />
    <ProjectReference Include="../../Axiam.Sdk/Axiam.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Glob so fixtures added later are copied automatically without csproj edits
         (mirrors Axiam.Sdk.Tests.csproj's identical pattern). -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
