<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- WebApplicationFactory/TestServer host for the SC#3 integration test (Task 3) —
         Microsoft.AspNetCore.Mvc.Testing transitively brings in Microsoft.AspNetCore.TestHost.

         Mvc.Testing ships a build per ASP.NET Core major and carries the matching
         shared-framework version with it, so its major must track the target
         framework (10.x for net10.0). The 10.0.14 pin matches the
         Microsoft.Extensions.* 10.0.14 already pinned in Axiam.Sdk.csproj. When a
         second target framework is added, condition this reference per framework. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Hosting/TestHost/Routing/Authorization APIs used to build the in-memory ASP.NET
       Core 8+ test host — mirrors the exact FrameworkReference pattern
       Axiam.Sdk.AspNetCore.csproj (D-03) and the core Axiam.Sdk.Tests.csproj (21-05,
       for its Grpc.AspNetCore.Server-hosted Kestrel test server) already use. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Axiam.Sdk.AspNetCore/Axiam.Sdk.AspNetCore.csproj" />
    <ProjectReference Include="../../Axiam.Sdk/Axiam.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Glob so fixtures added later are copied automatically without csproj edits
         (mirrors Axiam.Sdk.Tests.csproj's identical pattern). -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
